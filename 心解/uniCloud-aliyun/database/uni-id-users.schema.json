{
  "bsonType": "object",
  "required": [],
  "permission": {
    "read": "'auth.uid' != null",
    "create": "'auth.uid' == null",
    "update": "doc._id == auth.uid",
    "delete": false
  },
  "properties": {
    "username": {
      "bsonType": "string",
      "description": "用户名"
    },
    "password": {
      "bsonType": "string",
      "description": "密码（加密存储）"
    },
    "nickname": {
      "bsonType": "string",
      "description": "用户昵称"
    },
    "email": {
      "bsonType": "string",
      "description": "邮箱"
    },
    "mobile": {
      "bsonType": "string",
      "description": "手机号"
    },
    "avatar": {
      "bsonType": "string",
      "description": "头像 URL 或 fileID"
    },
    "role": {
      "bsonType": "array",
      "items": { "bsonType": "string" },
      "description": "角色列表，如 ['admin']"
    },
    "status": {
      "bsonType": "int",
      "description": "状态：0 正常 1 封禁 2 审核中 3 审核失败 4 已注销",
      "defaultValue": 0
    },
    "token": {
      "bsonType": "array",
      "items": { "bsonType": "string" },
      "description": "活跃 token 列表（最多 10 个）"
    },
    "last_login_ip": {
      "bsonType": "string",
      "description": "最后登录 IP"
    },
    "last_login_date": {
      "bsonType": "timestamp",
      "description": "最后登录时间"
    },
    "valid_token_date": {
      "bsonType": "timestamp",
      "description": "token 生效日期（早于此时间的 token 失效）"
    },
    "register_date": {
      "bsonType": "timestamp",
      "description": "注册时间"
    },
    "wx_openid": {
      "bsonType": "object",
      "description": "微信 openid / unionid",
      "properties": {
        "mp-weixin": { "bsonType": "string" }
      }
    },
    "apple_openid": {
      "bsonType": "string",
      "description": "Apple 登录 openid"
    }
  }
}
