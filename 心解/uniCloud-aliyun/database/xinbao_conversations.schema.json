{
  "bsonType": "object",
  "required": ["uid", "messages"],
  "permission": {
    "read": "doc.uid == auth.uid",
    "create": "doc.uid == auth.uid",
    "update": "doc.uid == auth.uid",
    "delete": "doc.uid == auth.uid"
  },
  "properties": {
    "uid": { "bsonType": "string", "description": "所属用户 uid" },
    "id": { "bsonType": "string", "description": "客户端对话 ID" },
    "title": { "bsonType": "string", "description": "对话标题（摘要）" },
    "messageCount": { "bsonType": "int", "description": "消息条数" },
    "messages": {
      "bsonType": "array",
      "description": "对话消息列表",
      "items": {
        "bsonType": "object",
        "properties": {
          "id": { "bsonType": "string" },
          "role": { "bsonType": "string", "enum": ["user", "xinbao"] },
          "content": { "bsonType": "string" },
          "time": { "bsonType": "string" },
          "hasChoices": { "bsonType": "bool" }
        }
      }
    },
    "time": { "bsonType": "string", "description": "对话时间 HH:mm" },
    "date": { "bsonType": "string", "description": "对话日期 YYYY-MM-DD" },
    "createdAt": { "bsonType": "timestamp" }
  }
}
