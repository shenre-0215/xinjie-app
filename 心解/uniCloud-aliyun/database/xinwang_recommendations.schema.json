{
  "bsonType": "object",
  "required": ["uid", "date"],
  "permission": {
    "read": "doc.uid == auth.uid",
    "create": "doc.uid == auth.uid",
    "update": "doc.uid == auth.uid",
    "delete": "doc.uid == auth.uid"
  },
  "properties": {
    "uid": {
      "bsonType": "string",
      "description": "所属用户 uid"
    },
    "date": {
      "bsonType": "string",
      "description": "推荐日期 YYYY-MM-DD"
    },
    "recommendations": {
      "bsonType": "array",
      "description": "每日推荐列表",
      "items": {
        "bsonType": "object",
        "properties": {
          "title": { "bsonType": "string" },
          "desc": { "bsonType": "string" },
          "cat": { "bsonType": "string" }
        }
      }
    },
    "createdAt": {
      "bsonType": "timestamp",
      "description": "创建时间"
    }
  }
}
