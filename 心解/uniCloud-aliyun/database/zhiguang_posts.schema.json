{
  "bsonType": "object",
  "required": ["content"],
  "permission": {
    "read": true,
    "create": "auth.uid != null",
    "update": "doc.uid == auth.uid",
    "delete": "doc.uid == auth.uid"
  },
  "properties": {
    "uid": {
      "bsonType": "string",
      "description": "发布者 uid"
    },
    "author": {
      "bsonType": "string",
      "description": "作者昵称"
    },
    "anonymous": {
      "bsonType": "bool",
      "description": "是否匿名发布"
    },
    "category": {
      "bsonType": "string",
      "description": "分类"
    },
    "content": {
      "bsonType": "string",
      "description": "帖子内容"
    },
    "tags": {
      "bsonType": "array",
      "items": { "bsonType": "string" },
      "description": "标签"
    },
    "image": {
      "bsonType": "string",
      "description": "图片 URL"
    },
    "resonatedCount": {
      "bsonType": "int",
      "description": "共鸣数"
    },
    "comments": {
      "bsonType": "array",
      "description": "评论列表",
      "items": {
        "bsonType": "object",
        "properties": {
          "id": { "bsonType": "string" },
          "author": { "bsonType": "string" },
          "content": { "bsonType": "string" },
          "time": { "bsonType": "string" }
        }
      }
    },
    "createdAt": {
      "bsonType": "timestamp",
      "description": "创建时间"
    },
    "updatedAt": {
      "bsonType": "timestamp",
      "description": "更新时间"
    }
  }
}
