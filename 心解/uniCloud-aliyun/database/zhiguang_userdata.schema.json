{
  "bsonType": "object",
  "required": ["uid"],
  "permission": {
    "read": "doc.uid == auth.uid",
    "create": "doc.uid == auth.uid",
    "update": "doc.uid == auth.uid",
    "delete": "doc.uid == auth.uid"
  },
  "properties": {
    "uid": {
      "bsonType": "string",
      "description": "所属用户 uid"
    },
    "myShares": {
      "bsonType": "array",
      "description": "我发布的帖子列表"
    },
    "favorites": {
      "bsonType": "array",
      "items": { "bsonType": "string" },
      "description": "收藏的帖子 ID 列表"
    },
    "createdAt": {
      "bsonType": "timestamp"
    },
    "updatedAt": {
      "bsonType": "timestamp"
    }
  }
}
