{
  "bsonType": "object",
  "required": ["uid", "content"],
  "permission": {
    "read": "doc.uid == auth.uid",
    "create": "doc.uid == auth.uid",
    "update": "doc.uid == auth.uid",
    "delete": "doc.uid == auth.uid"
  },
  "properties": {
    "uid": { "bsonType": "string", "description": "所属用户 uid" },
    "id": { "bsonType": "string", "description": "客户端记录 ID" },
    "type": { "bsonType": "string", "enum": ["diary", "thinking-chain"], "description": "记录类型" },
    "status": { "bsonType": "string", "enum": ["none", "suspended", "in-progress", "closed"], "description": "状态" },
    "content": { "bsonType": "string", "description": "内容" },
    "tags": { "bsonType": "array", "items": { "bsonType": "string" }, "description": "标签" },
    "mood": { "bsonType": "string", "description": "心情" },
    "date": { "bsonType": "string", "description": "日期 YYYY-MM-DD" },
    "time": { "bsonType": "string", "description": "时间 HH:mm" },
    "step": { "bsonType": "int", "description": "思考链当前步数" },
    "totalSteps": { "bsonType": "int", "description": "思考链总步数" },
    "title": { "bsonType": "string", "description": "标题" },
    "suspendedDays": { "bsonType": "int", "description": "悬置天数" },
    "stepIndex": { "bsonType": "int", "description": "悬置时所在步骤索引" },
    "delta": { "bsonType": "double", "description": "闭合质量值 δ(C)" },
    "source": { "bsonType": "string", "description": "来源：zhiji / xinbao" },
    "createdAt": { "bsonType": "timestamp" }
  }
}
